# Copy to .env (make init does this for you) and adjust as needed.

# Airflow needs your host UID so mounted folders are writable.
AIRFLOW_UID=50000

# Warehouse (separate from Airflow's metadata DB)
WAREHOUSE_DSN=postgresql://warehouse:warehouse@warehouse:5432/warehouse

# Landing zone inside the containers
DATA_ROOT=/opt/airflow/data

# Extra deps installed into the Airflow image at boot.
# Fine for local dev; for anything real, bake a custom image instead.
_PIP_ADDITIONAL_REQUIREMENTS=requests psycopg[binary]